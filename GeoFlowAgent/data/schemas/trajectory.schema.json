{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/geoflowagent/trajectory.schema.json",
  "title": "GeoFlowAgent demonstrated trajectory",
  "description": "An execution-validated sequence of callable tools. STOP is added by preprocessing and must not be stored here.",
  "type": "object",
  "required": [
    "task_id",
    "tool_ids"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "enum": [
            "<STOP>",
            "<PAD>"
          ]
        }
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
