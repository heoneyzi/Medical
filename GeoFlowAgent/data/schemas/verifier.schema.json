{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/geoflowagent/verifier.schema.json",
  "title": "GeoFlowAgent private verifier",
  "description": "Evaluation-only predicates combined with the public task goal for labels, replay, and terminal verification. This row is never serialized as model input.",
  "type": "object",
  "required": [
    "task_id",
    "private_verifier"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "private_verifier": {
      "$ref": "#/$defs/goal"
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "condition": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "op": {
          "enum": [
            "eq",
            "neq",
            "exists",
            "missing",
            "nonempty",
            "in",
            "not_in",
            "contains",
            "gte",
            "lte"
          ]
        },
        "value": true
      },
      "additionalProperties": true
    },
    "goal": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      },
      "additionalProperties": true
    }
  }
}
